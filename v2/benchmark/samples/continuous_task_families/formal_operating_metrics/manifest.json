{
  "schema_version": "statebus.continuous_task_family.v1",
  "family_id": "formal_operating_metrics_v1",
  "display_name": "Formal operating metrics reuse across disease and weather CSV inputs",
  "claim_tier": "formal_primary",
  "source_basis": {
    "repo_task_files": [
      "task/group2_tasks.json",
      "task/group2_gold.json"
    ],
    "design_note": "Five-round formal collection family: profile, aggregate, quality check, cross-input profile reuse, and lineage summary over repo-local CSV data."
  },
  "round_count": 5,
  "datasets": [
    {
      "dataset_id": "disease_estimates",
      "path": "task/csv/estimated_numbers.csv",
      "kind": "csv",
      "primary_columns": [
        "Country",
        "Year",
        "No. of cases",
        "No. of deaths",
        "No. of cases_min",
        "No. of deaths_max",
        "WHO Region"
      ]
    },
    {
      "dataset_id": "weather_baro_2015",
      "path": "task/csv/baro_2015.csv",
      "kind": "csv",
      "primary_columns": [
        "DATE TIME",
        "WINDSPEED",
        "DIR",
        "GUSTS",
        "AT",
        "BARO",
        "RELHUM",
        "VIS"
      ]
    }
  ],
  "quality_floor": {
    "deterministic_validator": [
      "answer_fields_present",
      "numeric_tolerance",
      "artifact_manifest_present"
    ],
    "fact_coverage": [
      "expected_fields_match_gold",
      "required_artifact_refs_present"
    ],
    "llm_judge": "optional_explanation_only"
  },
  "l0_l3_expectations": {
    "L0": {
      "required": [
        "quality_floor_pass"
      ],
      "expected_zero_metrics": [
        "semantic_state_transfer_count",
        "skipped_step_count"
      ]
    },
    "L1": {
      "required": [
        "control_bytes_delta_l0_to_l1 < 0"
      ]
    },
    "L2": {
      "required": [
        "semantic_state_transfer_count > 0",
        "raw_evidence_bytes_seen_by_llm_delta_l1_to_l2 < 0"
      ]
    },
    "L3": {
      "required": [
        "memory_match_count > 0",
        "artifact_reuse_count > 0",
        "history_reuse_gain > 0",
        "history_step_reduction_count > 0"
      ],
      "target_nonzero_rounds": [
        2,
        3,
        4,
        5
      ]
    }
  },
  "rounds": [
    {
      "round": 1,
      "task_id": "formal-ops-001",
      "dataset_id": "disease_estimates",
      "request_text": "Profile estimated_numbers.csv: infer column types, count rows, calculate missing-value percentages for No. of cases_min and No. of deaths_max, and persist a reusable schema profile artifact.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "profile_table",
        "required_outputs": [
          "schema_profile_ref",
          "missingness_summary",
          "summary_text"
        ],
        "required_tools": [
          "csv_profiler",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "task/csv/estimated_numbers.csv",
          "columns": [
            "No. of cases_min",
            "No. of deaths_max"
          ]
        }
      },
      "depends_on_rounds": [],
      "reuse_contract": {
        "produces": [
          "schema_profile:disease_estimates",
          "strategy:missingness_profile"
        ],
        "consumes": [],
        "minimum_reuse_class": "none"
      },
      "expected_facts": {
        "percentage_cases_min": "36.45",
        "percentage_deaths_max": "38.79"
      },
      "quality_checks": [
        "numeric_tolerance:percentage_cases_min:0.01",
        "numeric_tolerance:percentage_deaths_max:0.01",
        "artifact_exists:schema_profile_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 0,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 2,
      "task_id": "formal-ops-002",
      "dataset_id": "disease_estimates",
      "request_text": "Calculate the mean number of cases and identify the country/year with the highest recorded deaths in estimated_numbers.csv. Persist a stats artifact.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "aggregate_and_extreme",
        "required_outputs": [
          "stats_artifact_ref",
          "mean_cases",
          "max_deaths_country",
          "max_deaths_year"
        ],
        "required_tools": [
          "table_retriever",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "task/csv/estimated_numbers.csv",
          "mean_column": "No. of cases",
          "max_column": "No. of deaths"
        }
      },
      "depends_on_rounds": [
        1
      ],
      "reuse_contract": {
        "produces": [
          "stats_artifact:disease_cases_deaths"
        ],
        "consumes": [
          "schema_profile:disease_estimates"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "mean_cases": "2081990",
        "max_deaths_country": "Nigeria",
        "max_deaths_year": "2010"
      },
      "quality_checks": [
        "exact:mean_cases",
        "exact:max_deaths_country",
        "exact:max_deaths_year"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 3,
      "task_id": "formal-ops-003",
      "dataset_id": "disease_estimates",
      "request_text": "Detect outliers in No. of deaths_max using an IQR method and compare mean deaths before and after removing outliers.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "detect_outliers",
        "required_outputs": [
          "outlier_artifact_ref",
          "mean_no_of_deaths_with_outliers",
          "mean_no_of_deaths_without_outliers"
        ],
        "required_tools": [
          "table_retriever",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "task/csv/estimated_numbers.csv",
          "column": "No. of deaths_max",
          "method": "iqr",
          "threshold": 3
        }
      },
      "depends_on_rounds": [
        1,
        2
      ],
      "reuse_contract": {
        "produces": [
          "strategy:iqr_outlier",
          "outlier_artifact:disease_deaths_max"
        ],
        "consumes": [
          "schema_profile:disease_estimates",
          "stats_artifact:disease_cases_deaths"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "mean_no_of_deaths_with_outliers": "10149.43",
        "mean_no_of_deaths_without_outliers": "5949.08"
      },
      "quality_checks": [
        "numeric_tolerance:mean_no_of_deaths_with_outliers:0.01",
        "numeric_tolerance:mean_no_of_deaths_without_outliers:0.01"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 4,
      "task_id": "formal-ops-004",
      "dataset_id": "weather_baro_2015",
      "request_text": "Profile baro_2015.csv and calculate the mean wind speed, reusing the CSV profiling and mean aggregation strategy from the disease dataset.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "profile_and_mean",
        "required_outputs": [
          "schema_profile_ref",
          "mean_windspeed"
        ],
        "required_tools": [
          "csv_profiler",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "weather_baro_2015",
          "csv_path": "task/csv/baro_2015.csv",
          "column": "WINDSPEED"
        }
      },
      "depends_on_rounds": [
        1,
        2
      ],
      "reuse_contract": {
        "produces": [
          "schema_profile:weather_baro_2015",
          "stats_artifact:weather_windspeed"
        ],
        "consumes": [
          "strategy:missingness_profile",
          "stats_artifact:disease_cases_deaths"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "mean_windspeed": "5.979"
      },
      "quality_checks": [
        "numeric_tolerance:mean_windspeed:0.001",
        "artifact_exists:schema_profile_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 5,
      "task_id": "formal-ops-005",
      "dataset_id": "weather_baro_2015",
      "request_text": "Summarize the declared disease and weather artifacts and strategies reused across the preceding four operating-metric tasks.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "summarize_reuse_lineage",
        "required_outputs": [
          "summary_text",
          "reuse_report_ref",
          "reused_artifact_count",
          "reused_strategy_count"
        ],
        "required_tools": [
          "artifact_reader",
          "summarizer"
        ],
        "arguments": {
          "source_rounds": [
            1,
            2,
            3,
            4
          ],
          "required_lineage": [
            "schema_profile:disease_estimates",
            "stats_artifact:disease_cases_deaths",
            "outlier_artifact:disease_deaths_max",
            "schema_profile:weather_baro_2015",
            "stats_artifact:weather_windspeed"
          ]
        }
      },
      "depends_on_rounds": [
        1,
        2,
        3,
        4
      ],
      "reuse_contract": {
        "produces": [
          "reuse_report:formal_operating_metrics_v1"
        ],
        "consumes": [
          "schema_profile:disease_estimates",
          "stats_artifact:disease_cases_deaths",
          "outlier_artifact:disease_deaths_max",
          "strategy:iqr_outlier",
          "schema_profile:weather_baro_2015",
          "stats_artifact:weather_windspeed"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "reused_artifact_count_min": "5",
        "reused_strategy_count_min": "2"
      },
      "quality_checks": [
        "field_gte:reused_artifact_count:5",
        "field_gte:reused_strategy_count:2",
        "artifact_exists:reuse_report_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 5,
        "L3_skipped_step_count_min": 0,
        "L3_reuse_gain_min": 0,
        "L3_history_reuse_gain_min": 1,
        "L3_history_step_reduction_count_min": 2
      }
    }
  ]
}
