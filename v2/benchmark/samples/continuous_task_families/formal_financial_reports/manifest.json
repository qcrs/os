{
  "schema_version": "statebus.continuous_task_family.v1",
  "family_id": "formal_financial_reports_v1",
  "display_name": "Formal cross-period financial report analysis for ACME and BETA",
  "claim_tier": "formal_secondary",
  "source_basis": {
    "design_note": "Five-round formal collection family over repo-local financial-report data: two-company metric extraction, cross-period delta, and peer comparison with declared reuse edges."
  },
  "round_count": 5,
  "datasets": [
    {
      "dataset_id": "cross_period_financial",
      "path": "v2/benchmark/samples/continuous_task_families/cross_period_financial/cross_period_financial_report.md",
      "kind": "markdown_long_doc",
      "primary_entities": [
        "ACME",
        "BETA",
        "revenue",
        "revenue_musd"
      ]
    }
  ],
  "quality_floor": {
    "deterministic_validator": [
      "answer_fields_present",
      "artifact_manifest_present",
      "numeric_tolerance"
    ],
    "fact_coverage": [
      "required_metric_values_match",
      "metric_name_matches_request"
    ],
    "llm_judge": "not_required"
  },
  "l0_l3_expectations": {
    "L0": {
      "expected_zero_metrics": [
        "semantic_state_transfer_count",
        "skipped_step_count"
      ]
    },
    "L1": {
      "required": [
        "control_bytes_delta_l0_to_l1 < 0"
      ]
    },
    "L2": {
      "required": [
        "semantic_state_transfer_count > 0",
        "raw_evidence_bytes_seen_by_llm_delta_l1_to_l2 < 0"
      ]
    },
    "L3": {
      "required": [
        "memory_match_count > 0",
        "validated_replay_count > 0",
        "skipped_step_count > 0"
      ],
      "target_nonzero_rounds": [
        2,
        4
      ]
    }
  },
  "rounds": [
    {
      "round": 1,
      "task_id": "formal-financial-001",
      "dataset_id": "cross_period_financial",
      "request_text": "Extract the revenue figure for ACME in 2026Q1 from the cross-period financial report and persist a memory entry.",
      "canonical_task_spec": {
        "task_family": "cross_period_financial_analysis",
        "intent_op": "compare_metric",
        "required_outputs": [
          "revenue_value",
          "summary_text"
        ],
        "required_tools": [
          "table_retriever",
          "semantic_retriever"
        ],
        "arguments": {
          "ticker": "ACME",
          "quarter": "2026Q1",
          "metric": "revenue",
          "dataset_id": "cross_period_financial"
        }
      },
      "depends_on_rounds": [],
      "reuse_contract": {
        "produces": [
          "metric:acme_2026q1_revenue",
          "strategy:compare_metric_table_retriever"
        ],
        "consumes": [],
        "minimum_reuse_class": "none"
      },
      "expected_facts": {
        "revenue_value": "120"
      },
      "quality_checks": [
        "exact:revenue_value"
      ],
      "expected_metric_effects": {
        "L2_semantic_state_transfer_count_min": 1
      }
    },
    {
      "round": 2,
      "task_id": "formal-financial-002",
      "dataset_id": "cross_period_financial",
      "request_text": "Extract the revenue figure for ACME in 2025Q4 from the cross-period financial report.",
      "canonical_task_spec": {
        "task_family": "cross_period_financial_analysis",
        "intent_op": "compare_metric",
        "required_outputs": [
          "revenue_value",
          "summary_text"
        ],
        "required_tools": [
          "table_retriever",
          "semantic_retriever"
        ],
        "arguments": {
          "ticker": "ACME",
          "quarter": "2025Q4",
          "metric": "revenue",
          "dataset_id": "cross_period_financial"
        }
      },
      "depends_on_rounds": [
        1
      ],
      "reuse_contract": {
        "produces": [
          "metric:acme_2025q4_revenue"
        ],
        "consumes": [
          "strategy:compare_metric_table_retriever"
        ],
        "minimum_reuse_class": "validated_replay"
      },
      "expected_facts": {
        "revenue_value": "109"
      },
      "quality_checks": [
        "exact:revenue_value"
      ],
      "expected_metric_effects": {
        "L3_validated_replay_count_min": 1,
        "L3_skipped_step_count_min": 1
      }
    },
    {
      "round": 3,
      "task_id": "formal-financial-003",
      "dataset_id": "cross_period_financial",
      "request_text": "Compute the quarter-over-quarter revenue delta for ACME between 2025Q4 and 2026Q1. Both values are already in memory.",
      "canonical_task_spec": {
        "task_family": "cross_period_financial_analysis",
        "intent_op": "compute_delta",
        "required_outputs": [
          "delta_value",
          "delta_pct",
          "summary_text"
        ],
        "required_tools": [
          "table_retriever"
        ],
        "arguments": {
          "ticker": "ACME",
          "metric": "revenue",
          "period_from": "2025Q4",
          "period_to": "2026Q1",
          "dataset_id": "cross_period_financial"
        }
      },
      "depends_on_rounds": [
        1,
        2
      ],
      "reuse_contract": {
        "produces": [
          "analysis:acme_q4_to_q1_delta"
        ],
        "consumes": [
          "metric:acme_2026q1_revenue",
          "metric:acme_2025q4_revenue"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "delta_value": "11"
      },
      "quality_checks": [
        "exact:delta_value"
      ],
      "expected_metric_effects": {}
    },
    {
      "round": 4,
      "task_id": "formal-financial-004",
      "dataset_id": "cross_period_financial",
      "request_text": "Extract the revenue figure for BETA in 2026Q1 from the cross-period financial report.",
      "canonical_task_spec": {
        "task_family": "cross_period_financial_analysis",
        "intent_op": "compare_metric",
        "required_outputs": [
          "revenue_value",
          "summary_text"
        ],
        "required_tools": [
          "table_retriever",
          "semantic_retriever"
        ],
        "arguments": {
          "ticker": "BETA",
          "quarter": "2026Q1",
          "metric": "revenue",
          "dataset_id": "cross_period_financial"
        }
      },
      "depends_on_rounds": [
        1
      ],
      "reuse_contract": {
        "produces": [
          "metric:beta_2026q1_revenue"
        ],
        "consumes": [
          "strategy:compare_metric_table_retriever"
        ],
        "minimum_reuse_class": "validated_replay"
      },
      "expected_facts": {
        "revenue_value": "87"
      },
      "quality_checks": [
        "exact:revenue_value"
      ],
      "expected_metric_effects": {
        "L3_validated_replay_count_min": 1,
        "L3_skipped_step_count_min": 1
      }
    },
    {
      "round": 5,
      "task_id": "formal-financial-005",
      "dataset_id": "cross_period_financial",
      "request_text": "Compare ACME and BETA 2026Q1 revenue. Both values are already in memory.",
      "canonical_task_spec": {
        "task_family": "cross_period_financial_analysis",
        "intent_op": "compare_metric",
        "required_outputs": [
          "acme_revenue_value",
          "beta_revenue_value",
          "gap_value",
          "summary_text"
        ],
        "required_tools": [
          "table_retriever"
        ],
        "arguments": {
          "tickers": [
            "ACME",
            "BETA"
          ],
          "quarter": "2026Q1",
          "metric": "revenue",
          "dataset_id": "cross_period_financial"
        }
      },
      "depends_on_rounds": [
        1,
        4
      ],
      "reuse_contract": {
        "produces": [
          "analysis:acme_vs_beta_2026q1"
        ],
        "consumes": [
          "metric:acme_2026q1_revenue",
          "metric:beta_2026q1_revenue"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "gap_value": "33"
      },
      "quality_checks": [
        "exact:gap_value"
      ],
      "expected_metric_effects": {}
    }
  ]
}
