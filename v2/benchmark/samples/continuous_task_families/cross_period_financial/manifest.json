  "source_basis": {
    "design_note": "10-round continuous family demonstrating validated replay of reusable cross-period extraction strategy. Rounds 2/4/6/8 reuse the persisted compare_metric execution pattern while later compute rounds continue to execute against the current in-memory task state."
  },
  "round_count": 10,
  "datasets": [
    {
