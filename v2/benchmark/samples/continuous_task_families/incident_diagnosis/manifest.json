{
  "schema_version": "statebus.continuous_task_family.v1",
  "family_id": "incident_diagnosis_v2",
  "display_name": "Incident diagnosis replay chain",
  "claim_tier": "formal_secondary",
  "source_basis": {
    "design_note": "Startup-latency diagnosis family built on service boot logs to exercise semantic log retrieval, deterministic executor output, and replay progression."
  },
  "round_count": 10,
  "datasets": [
    {
      "dataset_id": "inference_gateway_boot",
      "path": "v2/benchmark/samples/incident_corpus/inference-gateway/boot_log.txt",
      "kind": "incident_log",
      "service": "inference-gateway"
    },
    {
      "dataset_id": "service_b_boot",
      "path": "v2/benchmark/samples/incident_corpus/service-b/boot_log.txt",
      "kind": "incident_log",
      "service": "service-b"
    },
    {
      "dataset_id": "service_c_boot",
      "path": "v2/benchmark/samples/incident_corpus/service-c/boot_log.txt",
      "kind": "incident_log",
      "service": "service-c"
    }
  ],
  "quality_floor": {
    "deterministic_validator": [
      "answer_fields_present",
      "artifact_manifest_present"
    ],
    "fact_coverage": [
      "expected_fields_match_gold",
      "required_artifact_refs_present"
    ],
    "llm_judge": "not_required"
  },
  "l0_l3_expectations": {
    "L0": {
      "expected_zero_metrics": [
        "semantic_state_transfer_count",
        "skipped_step_count"
      ]
    },
    "L1": {
      "required": [
        "control_bytes_delta_l0_to_l1 < 0"
      ]
    },
    "L2": {
      "required": [
        "semantic_state_transfer_count > 0",
        "raw_evidence_bytes_seen_by_llm_delta_l1_to_l2 < 0"
      ]
    },
    "L3": {
      "required": [
        "memory_match_count > 0",
        "validated_replay_count > 0",
        "exact_replay_count > 0",
        "skipped_step_count > 0"
      ],
      "target_nonzero_rounds": [
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9,
        10
      ]
    }
  },
  "rounds": [
    {
      "round": 1,
      "task_id": "incident-001",
      "dataset_id": "inference_gateway_boot",
      "request_text": "Diagnose why inference-gateway.service takes about 9 seconds to start and persist a reusable startup timing profile.",
      "canonical_task_spec": {
        "task_family": "incident_diagnosis_v2",
        "intent_op": "diagnose_startup_latency",
        "required_outputs": [
          "timing_profile_ref",
          "service_name",
          "slow_phase",
          "wait_duration_seconds",
          "root_cause",
          "summary_text"
        ],
        "required_tools": [
          "semantic_retriever",
          "codeact_executor",
          "artifact_writer"
        ],
        "arguments": {
          "dataset_id": "inference_gateway_boot",
          "log_path": "v2/benchmark/samples/incident_corpus/inference-gateway/boot_log.txt",
          "journal_path": "v2/benchmark/samples/incident_corpus/inference-gateway/journal.txt",
          "service_name": "inference-gateway.service",
          "phase_hint": "storage_mount",
          "symptom_family": "startup_latency"
        }
      },
      "depends_on_rounds": [],
      "reuse_contract": {
        "produces": [
          "timing_profile:startup_latency",
          "strategy:boot_timing_probe",
          "root_cause:high_io_wait"
        ],
        "consumes": [],
        "minimum_reuse_class": "none"
      },
      "expected_facts": {
        "service_name": "inference-gateway.service",
        "slow_phase": "storage_mount",
        "wait_duration_seconds": "6.5",
        "root_cause": "high_io_wait"
      },
      "quality_checks": [
        "artifact_exists:timing_profile_ref",
        "exact:slow_phase",
        "numeric_tolerance:wait_duration_seconds:0.1"
      ],
      "expected_metric_effects": {
        "L2_semantic_state_transfer_count_min": 1
      }
    },
