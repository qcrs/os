mode: api

providers:
  default:
    kind: openai_compatible
    base_url: https://api.deepseek.com
    api_key_env: STATEBUS_LLM_API_KEY
    timeout_s: 60

roles:
  planner:
    provider: default
    model: deepseek-v4-flash
    json_output: true
    temperature: 0.0
    max_tokens: 1200
    extra_body:
      thinking:
        type: disabled

  summarizer:
    provider: default
    model: deepseek-v4-flash
    json_output: true
    temperature: 0.0
    max_tokens: 1200
    extra_body:
      thinking:
        type: disabled
