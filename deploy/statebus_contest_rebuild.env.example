#!/usr/bin/env bash

# Optional host-specific overrides loaded by
# deploy/activate_statebus_contest_rebuild.sh. Copy this file to
# deploy/statebus_contest_rebuild.env.local only when an override is needed.

export STATEBUS_CONTEST_VLLM_MODEL_PATH="/data/models/Qwen3-32B"
export STATEBUS_CONTEST_VLLM_TOKENIZER_PATH="/data/models/Qwen3-32B"
export STATEBUS_CONTEST_VLLM_ENV_PREFIX="$HOME/statebus/conda-envs/vllm-qwen-cu121"
export STATEBUS_CONTEST_VLLM_HOST="127.0.0.1"
export STATEBUS_CONTEST_VLLM_PORT="53334"
export STATEBUS_CONTEST_VLLM_CUDA_VISIBLE_DEVICES="1"
export STATEBUS_CONTEST_VLLM_TENSOR_PARALLEL_SIZE="1"
export STATEBUS_CONTEST_VLLM_MAX_MODEL_LEN="8192"
export STATEBUS_CONTEST_VLLM_MAX_NUM_SEQS="1"
export STATEBUS_CONTEST_VLLM_MAX_NUM_BATCHED_TOKENS="8192"
export STATEBUS_CONTEST_VLLM_GPU_MEMORY_UTILIZATION="0.82"
export STATEBUS_CONTEST_VLLM_EXPECTED_VERSION="0.9.2"
export STATEBUS_CONTEST_VLLM_USE_V1="0"
export STATEBUS_CONTEST_VLLM_MAX_LOGPROBS="20"
export STATEBUS_CONTEST_VLLM_ENABLE_REQUEST_ID_HEADERS="1"
export STATEBUS_CONTEST_LATENT_API_TOKEN_FILE="$HOME/statebus/work/latent_api.token"
# export STATEBUS_CONTEST_VLLM_CPU_OFFLOAD_GB="8"
# export STATEBUS_CONTEST_VLLM_KV_CACHE_DTYPE="auto"
# export STATEBUS_CONTEST_VLLM_NUM_GPU_BLOCKS_OVERRIDE=""

# All mutable data remains under the user-owned STATEBUS_HOME tree.
# export STATEBUS_CONTEST_DATA_ROOT="$HOME/statebus/work/contest-rebuild/data"
# export STATEBUS_CONTEST_RUN_ROOT="$HOME/statebus/runs/contest-rebuild-v1"
# export STATEBUS_CONTEST_LOG_ROOT="$HOME/statebus/logs/contest-rebuild-v1"

# These gates authorize external or state-changing actions. Keep them at 0
# during environment preparation. Enabling one gate never enables another.
export STATEBUS_CONTEST_ALLOW_METRICS_CHECK="0"
export STATEBUS_CONTEST_ALLOW_TOP_LOGPROBS_PROBE="0"
export STATEBUS_CONTEST_ALLOW_FILING_DOWNLOAD="0"
export STATEBUS_CONTEST_ALLOW_FORMAL_EXPERIMENTS="0"
export STATEBUS_CONTEST_ALLOW_COLD_CACHE="0"
export STATEBUS_CONTEST_ALLOW_SERVICE_RESTART="0"
export STATEBUS_CONTEST_ALLOW_OPENEULER_VALIDATION="0"

# Formal request defaults. The long-lived server has the latent extension loaded,
# while experiment-side latent use remains forcibly off in the prepare profile.
export STATEBUS_CONTEST_PREFIX_POLICY="off"
export STATEBUS_CONTEST_LOGIT_POLICY="off"
export STATEBUS_CONTEST_PREFIX_FEEDBACK_ADAPTIVE="0"
