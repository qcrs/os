mode: local_vllm

providers:
  default:
    kind: openai_compatible
    base_url: http://127.0.0.1:8000/v1
    api_key: EMPTY
    timeout_s: 120
    request_max_attempts: 1

roles:
  planner:
    provider: default
    model: qwen3-32b
    json_output: true
    temperature: 0.0
    max_tokens: 1024
  retriever:
    provider: default
    model: qwen3-32b
    json_output: true
    temperature: 0.0
    max_tokens: 1024
  executor:
    provider: default
    model: qwen3-32b
    json_output: true
    temperature: 0.0
    max_tokens: 1536
  summarizer:
    provider: default
    model: qwen3-32b
    json_output: true
    temperature: 0.0
    max_tokens: 1024
