#!/usr/bin/env bash

# 复制为 deploy/statebus_llm.env.local 后填写密钥。本文件由
# deploy/activate_statebus_host.sh 自动读取；长期模型路由和角色参数应放在
# deploy/statebus_llm.yaml.local 中。

export STATEBUS_LLM_API_KEY="replace-with-your-api-key"

# 可选的临时覆盖：
# export STATEBUS_LLM_MODE="api"
# export STATEBUS_LLM_CONFIG_FILE="/path/to/statebus/deploy/statebus_llm.yaml.local"
# export STATEBUS_EMBED_DEVICE="cpu"
# export STATEBUS_EMBED_DEVICE="cuda:0"
#
# local_vllm / KV 实验可选的证据预算裁剪配置：
# export STATEBUS_EVIDENCE_DYNAMIC_PRUNING_ENABLED="1"
# export STATEBUS_EVIDENCE_AVAILABLE_KV_CACHE_BYTES="8589934592"
# export STATEBUS_EVIDENCE_KV_BYTES_PER_TOKEN="256"
# export STATEBUS_EVIDENCE_BASE_IMPORTANCE_THRESHOLD="0.6"
# export STATEBUS_EVIDENCE_CAPACITY_BUFFER="0.2"
# export STATEBUS_EVIDENCE_MIN_KEEP_SEMANTIC_CONTEXTS="1"
# export STATEBUS_EVIDENCE_MIN_KEEP_LEXICAL_HINTS="0"
#
# 可选的 vLLM CPU offload；默认不要设置，仅在显存不足时使用。
# export STATEBUS_VLLM_CPU_OFFLOAD_GB="8"
