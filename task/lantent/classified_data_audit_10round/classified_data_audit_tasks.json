{
  "suite_id": "classified_data_audit_latent_kv_10round_v1",
  "suite_name": "合成涉密数据访问审计长中间推理任务集",
  "language": "zh-CN",
  "model_target": "Qwen3-8B",
  "task_type": "classified_data_analysis_long_intermediate_short_answer",
  "synthetic_notice": "本任务集全部为合成脱敏场景，不包含真实涉密数据、真实人员、真实项目或真实系统口令。",
  "design_goal": "构造一组正确率更容易提升、同时适合 latent_kv 的涉密数据分析计算任务。每轮有长证据、长审计解释和计算矩阵，但最终只输出 4 字段短 JSON。公式全部为整数加减法，便于 executor 用短 CodeAct 计算并校验。",
  "why_latent_kv_should_help": [
    "每轮都共享同一套保密分级、访问通道、处置动作和风险分层规则，structured 模式会反复把这些长规则和分析文本传给下游。",
    "researcher 需要把审计线索、访问动机、历史继承和候选 case 解释成长证据报告。",
    "analyst 需要比较 3 个候选 case 的风险路径，说明为什么最高风险 case 应优先处置。",
    "executor 只需要按固定公式计算 risk_score 并选择 tier/action，最终答案短且可精确评测。",
    "相比事故响应 6 字段任务，本任务最终只要求 case_id、risk_score、tier、action 四个字段，正确率应更高。"
  ],
  "required_d_mode_topology": "planner -> 3x researcher -> analyst_latent -> executor_latent -> summarizer_latent",
  "latent_config_recommendation": {
    "ANALYST_LATENT_STEPS": 48,
    "EXECUTOR_LATENT_STEPS": 24,
    "POST_EXEC_LATENT_STEPS": 8,
    "SUMMARIZER_LATENT_STEPS": 0,
    "note": "任务需要长中间解释，但最终计算简单，建议 latent steps 少于事故响应任务，以提高速度和降低 drift。"
  },
  "output_schema": {
    "case_id": "string",
    "risk_score": "integer",
    "tier": "LOW|MEDIUM|HIGH|CRITICAL",
    "action": "one valid action"
  },
  "quality_metric": {
    "type": "exact_structured_match",
    "fields": [
      "case_id",
      "risk_score",
      "tier",
      "action"
    ],
    "pass_condition": "四个字段全部精确匹配 reference_answer 才算该轮通过"
  },
  "shared_context": {
    "system": "ArgusSecure 是一个合成的涉密数据访问审计平台，用于审计研发、财务、人事、客户和国防项目数据的导出、批处理和跨域访问。每轮任务代表一个新的审计窗口，系统需要选择最高优先级的风险 case，并给出短 JSON 处置结论。",
    "confidentiality_policy": [
      "S1 内部数据：sensitivity_points=10",
      "S2 限制传播数据：sensitivity_points=20",
      "S3 秘密级业务数据：sensitivity_points=30",
      "S4 核心涉密数据：sensitivity_points=40"
    ],
    "domain_points": {
      "finance": 8,
      "personnel": 6,
      "source_code": 10,
      "customer": 7,
      "defense_project": 12
    },
    "channel_points": {
      "bastion": 2,
      "vpn": 4,
      "emergency_console": 6,
      "batch_export": 8
    },
    "risk_formula": "risk_score = sensitivity_points + domain_points + channel_points + anomaly_points + repeat_points - mitigation_points",
    "tier_rule": {
      "CRITICAL": "risk_score >= 70",
      "HIGH": "55 <= risk_score < 70",
      "MEDIUM": "40 <= risk_score < 55",
      "LOW": "risk_score < 40"
    },
    "action_rule": {
      "CRITICAL": "isolate_account_and_open_major_incident",
      "HIGH": "freeze_export_and_start_review",
      "MEDIUM": "require_manager_reapproval",
      "LOW": "log_and_monitor"
    },
    "valid_actions": [
      "isolate_account_and_open_major_incident",
      "freeze_export_and_start_review",
      "require_manager_reapproval",
      "log_and_monitor"
    ],
    "required_intermediate_work": [
      "researcher 必须输出 900-1300 中文字的证据报告，解释每个候选 case 的访问路径、涉密等级、异常原因和历史继承。",
      "analyst 必须输出 900-1300 中文字的长分析，比较 3 个候选 case，说明最高风险 case 的排序依据。",
      "executor 必须输出计算矩阵：逐 case 列出公式各项、risk_score、tier 和 action。",
      "summarizer 只输出 final_contract JSON，不输出长解释。"
    ],
    "final_answer_contract": {
      "case_id": "<highest risk case id>",
      "risk_score": "<integer risk_score>",
      "tier": "<LOW|MEDIUM|HIGH|CRITICAL>",
      "action": "<one valid action>"
    }
  },
