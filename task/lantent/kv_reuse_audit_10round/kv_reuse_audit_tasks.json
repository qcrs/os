{
  "suite_id": "kv_reuse_audit_fanout_10round_v1",
  "suite_name": "KV复用审计状态扇出连续任务集",
  "language": "zh-CN",
  "model_target": "Qwen3-8B",
  "task_type": "continuous_large_state_fanout_extractive_qa",
  "design_goal": "构造一个更适合 latent_kv 的任务形态：每轮先形成一个较大的审计状态包，然后由多个下游 reviewer 从同一状态中抽取短答案。A/B 需要每个 reviewer 重复读取完整状态，D 可以预填充一次 KV 后复用。",
  "latent_value": [
    "每轮 transfer_state 是大共享状态，后续 5 个 reviewer 问题都依赖同一状态。",
    "A_text 基线应把 prose transfer_state 重复放入每个 reviewer prompt。",
    "B_structured 基线应把 structured JSON transfer_state 重复放入每个 reviewer prompt。",
    "D_latent_kv 应对 structured transfer_state 只 prefill 一次，再对 5 个 reviewer decode 复用同一 KV handle。",
    "任务是抽取式答案，质量用 answer + cite 精确匹配，避免用速度牺牲答案质量。"
  ],
  "latent_config_recommendation": {
    "analyst_latent_steps": 0,
    "executor_latent_steps": 0,
    "post_exec_latent_steps": 0,
    "note": "当前 latent aligner 是未训练 normalized_identity，本任务优先展示 KV state reuse；需要 stress test 时可额外加少量 latent steps。"
  },
  "shared_context": {
    "state_expansion_policy": "每轮 transfer_state.answer_capsule 是事实源；distractor_seed 和 distractor_count 用于生成大量干扰审计日志，使状态足够长。",
    "default_distractor_count": 96,
    "reviewer_count_per_round": 5,
    "output_contract": "每个 reviewer 只输出紧凑 JSON：{\"answer\":\"...\",\"cite\":\"...\"}",
    "quality_rule": "answer 和 cite 必须同时与 reference_answer 精确匹配才算正确。",
    "continuity_rule": "10轮连续任务按时间推进；每轮可继承前一轮的审计口径，但当前轮答案只来自当前轮 ANSWER_CAPSULE。"
  },
  "output_schema": {
    "answer": "string",
    "cite": "string"
  },
