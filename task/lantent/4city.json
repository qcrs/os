{
  "suite_id": "4city_reasoning_5round_v1",
  "suite_name": "四城市巡检路线简化推理任务集",
  "language": "zh-CN",
  "model_target": "Qwen3-8B",
  "task_type": "simple_combinatorial_reasoning",
  "benchmark_goal": [
    "验证多智能体在简单组合优化场景下的 latent KV 传递效果",
    "对比 text、structured 和 latent_kv 三种模式的通信开销",
    "确保任务难度适中，模型能够给出正确答案"
  ],
  "agent_policy": {
    "autonomous_planning": true,
    "codeact_required": true,
    "final_answer_should_include": [
      "最优路线",
      "总成本",
      "简短验证说明"
    ]
  },
  "shared_context": {
    "description": "有 A、B、C、D 四个城市。路线从 A 出发，访问其余每个城市恰好一次，最后返回 A。距离是对称的。",
    "cities": [
      "A",
      "B",
      "C",
      "D"
    ],
    "distance_matrix": {
      "A": {
        "A": 0,
        "B": 10,
        "C": 15,
        "D": 20
      },
      "B": {
        "A": 10,
        "B": 0,
        "C": 35,
        "D": 25
      },
      "C": {
        "A": 15,
        "B": 35,
        "C": 0,
        "D": 30
      },
      "D": {
        "A": 20,
        "B": 25,
        "C": 30,
        "D": 0
      }
    },
    "default_rules": [
      "每个城市恰好访问一次",
      "路线从 A 出发并返回 A",
      "距离矩阵对称",
      "正向路线和完全反向路线视为同一个环形方案",
      "只有 3!=6 种候选路线（A 固定起点，剩余 3 个城市全排列）",
      "必须使用 Python 代码枚举所有 6 种路线并计算成本，选择最小值"
    ]
  },
  "output_schema": {
    "route": [
      "A",
      "...",
      "A"
    ],
    "total_cost": "integer",
    "verification": "short string explaining why this is optimal"
  },
  "tasks": [
    {
      "round": 1,
      "task_id": "route_round_01",
      "title": "基础最短巡回路线",
      "inherits": [
        "shared_context"
      ],
      "prompt": "求从 A 出发、访问 B、C、D 各一次并返回 A 的最短路线。**必须用 Python 代码枚举所有 6 种可能路线，计算每种的总成本，选择最小值。** 给出最优路线、总成本和简短验证。",
      "hint": "6 种路线：A→B→C→D→A, A→B→D→C→A, A→C→B→D→A, A→C→D→B→A, A→D→B→C→A, A→D→C→B→A",
      "reference_answer": {
        "route": [
          "A",
          "B",
          "D",
          "C",
          "A"
        ],
        "reverse_route_also_valid": true,
        "total_cost": 80,
        "calculation": "10 + 25 + 30 + 15 = 80",
        "alternative_routes": [
          {
            "route": ["A", "C", "D", "B", "A"],
            "cost": 80,
            "note": "反向路线，成本相同"
          }
        ]
      }
    },
    {
      "round": 2,
      "task_id": "route_round_02",
      "title": "道路关闭后的重新规划",
      "inherits": [
        "shared_context",
        "round_01_context"
      ],
      "prompt": "沿用相同距离矩阵，但道路 B-D 已关闭，路线中不得直接经过 B-D。**用 Python 代码验证所有 6 种路线，排除包含 B-D 的路线，从剩余路线中选择最短的。** 比较它相对第 1 轮最优路线增加了多少成本。",
      "reference_answer": {
        "route": [
          "A",
          "B",
          "C",
          "D",
          "A"
        ],
        "reverse_route_also_valid": true,
        "total_cost": 90,
        "cost_increase_from_round_01": 10,
        "calculation": "10 + 35 + 30 + 20 = 90",
        "excluded_routes": [
          "A→B→D→C→A (包含 B-D)",
          "A→D→B→C→A (包含 B-D)"
        ]
      }
    },
    {
      "round": 3,
      "task_id": "route_round_03",
      "title": "包含指定道路的最短路线",
      "inherits": [
        "shared_context"
      ],
      "prompt": "恢复全部道路，但要求路线必须直接经过道路 A-C。**用 Python 代码筛选包含 A-C 的路线，从中选择成本最小的。** 验证 A-C 确实在最终路线中。",
      "reference_answer": {
        "route": [
          "A",
          "C",
          "D",
          "B",
          "A"
        ],
        "reverse_route_also_valid": true,
        "total_cost": 80,
        "required_edge": [
          "A",
          "C"
        ],
        "calculation": "15 + 30 + 25 + 10 = 80"
      }
    },
    {
      "round": 4,
      "task_id": "route_round_04",
      "title": "带访问先后顺序的巡回路线",
      "inherits": [
        "shared_context"
      ],
      "prompt": "求从 A 出发并返回 A 的最短路线，但在实际行进方向上必须先访问 B 再访问 D。**用 Python 代码筛选满足 B 在 D 之前的路线，从中选择最短的。** 注意：反向路线不再等价，因为顺序约束破坏了对称性。",
      "reference_answer": {
        "route": [
          "A",
          "B",
          "D",
          "C",
          "A"
        ],
        "reverse_route_also_valid": false,
        "total_cost": 80,
        "order_constraint": "B before D",
        "calculation": "10 + 25 + 30 + 15 = 80"
      }
    },
    {
      "round": 5,
      "task_id": "route_round_05",
      "title": "固定终点的最短哈密顿路径",
      "inherits": [
        "shared_context"
      ],
      "prompt": "本轮不要求返回 A。求从 A 出发、访问 B、C、D 各一次并最终停在 D 的最短路径。**用 Python 代码枚举所有 3!=6 种路径（A→?→?→D），选择成本最小的。**",
      "reference_answer": {
        "route": [
          "A",
          "B",
          "C",
          "D"
        ],
        "reverse_route_also_valid": false,
        "total_cost": 75,
        "calculation": "10 + 35 + 30 = 75",
        "note": "不返回 A，省去最后一段"
      }
    },
    {
      "round": 6,
      "task_id": "route_round_06",
      "title": "最大化路径成本",
      "inherits": [
        "shared_context"
      ],
      "prompt": "求从 A 出发、访问 B、C、D 各一次并返回 A 的**最长**路线（成本最大）。**用 Python 代码枚举所有 6 种路线，选择成本最大的。**",
      "reference_answer": {
        "route": [
          "A",
          "B",
          "C",
          "D",
          "A"
        ],
        "reverse_route_also_valid": true,
        "total_cost": 90,
        "calculation": "10 + 35 + 30 + 20 = 90"
      }
    },
    {
      "round": 7,
      "task_id": "route_round_07",
      "title": "禁止特定道路",
      "inherits": [
        "shared_context"
      ],
      "prompt": "求最短巡回路线，但路线中不得直接经过道路 A-B。**用 Python 代码排除包含 A-B 的路线，从剩余路线中选择最短的。**",
      "reference_answer": {
        "route": [
          "A",
          "C",
          "D",
          "B",
          "A"
        ],
        "reverse_route_also_valid": true,
        "total_cost": 80,
        "calculation": "15 + 30 + 25 + 10 = 80",
        "forbidden_edge": ["A", "B"]
      }
    },
    {
      "round": 8,
      "task_id": "route_round_08",
      "title": "次优路线",
      "inherits": [
        "shared_context",
        "round_01_context"
      ],
      "prompt": "求基础问题中的严格第二短巡回路线。它不能与第 1 轮最优路线相同，也不能只是第 1 轮路线的反向表示。**用 Python 代码枚举所有路线，排除第1轮的最优等价类（正向和反向），从剩余路线中选择最短的。** 说明它与最优路线的成本差。",
      "reference_answer": {
        "route": [
          "A",
          "B",
          "C",
          "D",
          "A"
        ],
        "reverse_route_also_valid": true,
        "total_cost": 90,
        "cost_gap_from_round_01": 10,
        "calculation": "10 + 35 + 30 + 20 = 90"
      }
    },
    {
      "round": 9,
      "task_id": "route_round_09",
      "title": "强制两条道路",
      "inherits": [
        "shared_context"
      ],
      "prompt": "求最短巡回路线，要求路线必须同时包含道路 A-B 和道路 C-D。**用 Python 代码筛选同时包含这两条边的路线，从中选择最短的。**",
      "reference_answer": {
        "route": [
          "A",
          "B",
          "D",
          "C",
          "A"
        ],
        "reverse_route_also_valid": true,
        "total_cost": 80,
        "calculation": "10 + 25 + 30 + 15 = 80",
        "required_edges": [["A", "B"], ["C", "D"]]
      }
    },
    {
      "round": 10,
      "task_id": "route_round_10",
      "title": "固定起点和终点的路径",
      "inherits": [
        "shared_context"
      ],
      "prompt": "求从 A 出发、访问 B、C 各一次并最终停在 B 的最短路径（不要求返回 A，也不要求访问 D）。**用 Python 代码枚举所有可能路径，选择成本最小的。**",
      "reference_answer": {
        "route": [
          "A",
          "C",
          "B"
        ],
        "reverse_route_also_valid": false,
        "total_cost": 50,
        "calculation": "15 + 35 = 50",
        "note": "只访问 B、C，不访问 D"
      }
    }
  ],
  "evaluation": {
    "reference_answer_visibility": "evaluator_only",
    "run_modes": [
      "text",
      "structured",
      "latent_kv"
    ],
    "required_metrics": [
      "task_accuracy",
      "input_tokens",
      "output_tokens",
      "latent_steps",
      "latent_kv_bytes_transferred",
      "total_latency_ms"
    ],
    "recommended_latent_steps": {
      "analyst": [
        32,
        64
      ],
      "executor": [
        16,
        32
      ]
    },
    "success_condition": "路线和成本正确，Python 代码能够验证所有候选路线。"
  }
}
