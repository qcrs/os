# 使用 Docker Compose 前复制为 docker/.env。
# 如果宿主机用户不是 1000:1000，需要改成 id -u 和 id -g 的结果。
STATEBUS_USER_NAME=qcrs
STATEBUS_UID=1000
STATEBUS_GID=1000

# embed target 包含本地 Embedding 依赖。Embedding 默认走 CPU，因此
# StateBus 应用容器本身不申请 GPU。
STATEBUS_DOCKER_TARGET=embed
STATEBUS_EMBED_DEVICE=cpu
STATEBUS_STUDIO_EMBED_DEVICE=cpu

# 宿主机模型目录以只读方式挂载进应用容器，用于 tokenizer 和身份校验。
STATEBUS_VLLM_MODELS_ROOT=/data/models
STATEBUS_VLLM_MODEL_PATH=/data/models/Qwen3-32B
STATEBUS_VLLM_TOKENIZER_PATH=/data/models/Qwen3-32B
STATEBUS_LOCAL_VLLM_BASE_URL=http://127.0.0.1:53334/v1
STATEBUS_LOCAL_VLLM_HEALTH_URL=http://127.0.0.1:53334/health
STATEBUS_VLLM_METRICS_URL=http://127.0.0.1:53334/metrics

# 默认连接本地 vLLM。使用外部 API 时，改为容器内的
# /workspace/statebus/project/deploy/statebus_llm.yaml.local。
STATEBUS_LLM_CONFIG_FILE=/workspace/statebus/project/deploy/statebus_llm.local_vllm.example

# 模型侧增强能力均需显式开启；以下默认值保持普通 StateBus 主链。
STATEBUS_PREFIX_ALIGNMENT_MODE=independent
STATEBUS_PREFIX_POLICY=off
STATEBUS_LOGIT_GATE_MODE=off
STATEBUS_ENGINE_LOCAL_KV_MODE=off

# 以下配置只用于显式 KV continuation。宿主机 ~/statebus/work 下的 token
# 在应用容器中对应 /statebus/work 路径。
# STATEBUS_KV_API_BASE_URL=http://127.0.0.1:53334
# STATEBUS_KV_API_TOKEN_FILE=/statebus/work/vllm-qwen3-32b/kv_api.token
# STATEBUS_ENGINE_LOCAL_KV_MODEL=qwen3-32b
# STATEBUS_ENGINE_LOCAL_KV_PARENT_TOKENS=4096
