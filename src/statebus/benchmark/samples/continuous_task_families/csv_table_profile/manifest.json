{
  "schema_version": "statebus.continuous_task_family.v1",
  "family_id": "csv_table_profile_v1",
  "display_name": "CSV table profile and cross-dataset strategy reuse",
  "claim_tier": "formal_primary",
  "source_basis": {
    "repo_task_files": [
      "datasets/operating_metrics/group2_tasks.json",
      "datasets/operating_metrics/group2_gold.json"
    ],
    "design_note": "Derived from the local Group 2 disease/weather task set, tightened into artifact-first continuous rounds."
  },
  "round_count": 10,
  "datasets": [
    {
      "dataset_id": "disease_estimates",
      "path": "datasets/operating_metrics/estimated_numbers.csv",
      "kind": "csv",
      "primary_columns": [
        "Country",
        "Year",
        "No. of cases",
        "No. of deaths",
        "No. of cases_min",
        "No. of deaths_max",
        "WHO Region"
      ]
    },
    {
      "dataset_id": "weather_baro_2015",
      "path": "datasets/operating_metrics/baro_2015.csv",
      "kind": "csv",
      "primary_columns": [
        "DATE TIME",
        "WINDSPEED",
        "DIR",
        "GUSTS",
        "AT",
        "BARO",
        "RELHUM",
        "VIS"
      ]
    }
  ],
  "quality_floor": {
    "deterministic_validator": [
      "answer_fields_present",
      "numeric_tolerance",
      "artifact_manifest_present"
    ],
    "fact_coverage": [
      "expected_fields_match_gold",
      "required_artifact_refs_present"
    ],
    "llm_judge": "optional_explanation_only"
  },
  "l0_l3_expectations": {
    "L0": {
      "required": [
        "quality_floor_pass"
      ],
      "expected_zero_metrics": [
        "semantic_state_transfer_count",
        "skipped_step_count"
      ]
    },
    "L1": {
      "required": [
        "control_bytes_delta_l0_to_l1 < 0"
      ]
    },
    "L2": {
      "required": [
        "semantic_state_transfer_count > 0",
        "raw_evidence_bytes_seen_by_llm_delta_l1_to_l2 < 0"
      ]
    },
    "L3": {
      "required": [
        "memory_match_count > 0",
        "artifact_reuse_count > 0",
        "history_reuse_gain > 0",
        "history_step_reduction_count > 0"
      ],
      "target_nonzero_rounds": [
        4,
        5,
        7,
        8,
        9,
        10
      ]
    }
  },
  "rounds": [
    {
      "round": 1,
      "task_id": "csv-profile-001",
      "dataset_id": "disease_estimates",
      "request_text": "Profile estimated_numbers.csv: infer column types, count rows, calculate missing-value percentages for No. of cases_min and No. of deaths_max, and persist a reusable schema profile artifact.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "profile_table",
        "required_outputs": [
          "schema_profile_ref",
          "missingness_summary",
          "summary_text"
        ],
        "required_tools": [
          "csv_profiler",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "datasets/operating_metrics/estimated_numbers.csv",
          "columns": [
            "No. of cases_min",
            "No. of deaths_max"
          ]
        }
      },
      "depends_on_rounds": [],
      "reuse_contract": {
        "produces": [
          "schema_profile:disease_estimates",
          "strategy:missingness_profile"
        ],
        "consumes": [],
        "minimum_reuse_class": "none"
      },
      "expected_facts": {
        "percentage_cases_min": "36.45",
        "percentage_deaths_max": "38.79"
      },
      "quality_checks": [
        "numeric_tolerance:percentage_cases_min:0.01",
        "numeric_tolerance:percentage_deaths_max:0.01",
        "artifact_exists:schema_profile_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 0,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 2,
      "task_id": "csv-profile-002",
      "dataset_id": "disease_estimates",
      "request_text": "Calculate the mean number of cases and identify the country/year with the highest recorded deaths in estimated_numbers.csv. Persist a stats artifact.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "aggregate_and_extreme",
        "required_outputs": [
          "stats_artifact_ref",
          "mean_cases",
          "max_deaths_country",
          "max_deaths_year"
        ],
        "required_tools": [
          "table_retriever",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "datasets/operating_metrics/estimated_numbers.csv",
          "mean_column": "No. of cases",
          "max_column": "No. of deaths"
        }
      },
      "depends_on_rounds": [
        1
      ],
      "reuse_contract": {
        "produces": [
          "stats_artifact:disease_cases_deaths"
        ],
        "consumes": [
          "schema_profile:disease_estimates"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "mean_cases": "2081990",
        "max_deaths_country": "Nigeria",
        "max_deaths_year": "2010"
      },
      "quality_checks": [
        "exact:mean_cases",
        "exact:max_deaths_country",
        "exact:max_deaths_year"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 3,
      "task_id": "csv-profile-003",
      "dataset_id": "disease_estimates",
      "request_text": "Calculate the Pearson correlation between No. of cases and No. of deaths after applying the missingness policy from the table profile.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "correlate_columns",
        "required_outputs": [
          "correlation_artifact_ref",
          "correlation_coefficient"
        ],
        "required_tools": [
          "table_retriever",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "datasets/operating_metrics/estimated_numbers.csv",
          "left_column": "No. of cases",
          "right_column": "No. of deaths",
          "method": "pearson"
        }
      },
      "depends_on_rounds": [
        1
      ],
      "reuse_contract": {
        "produces": [
          "strategy:pearson_correlation",
          "correlation_artifact:disease_cases_deaths"
        ],
        "consumes": [
          "schema_profile:disease_estimates",
          "strategy:missingness_profile"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "correlation_coefficient": "0.97"
      },
      "quality_checks": [
        "numeric_tolerance:correlation_coefficient:0.01"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 4,
      "task_id": "csv-profile-004",
      "dataset_id": "disease_estimates",
      "request_text": "Detect outliers in No. of deaths_max using an IQR method and compare mean deaths before and after removing outliers.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "detect_outliers",
        "required_outputs": [
          "outlier_artifact_ref",
          "mean_no_of_deaths_with_outliers",
          "mean_no_of_deaths_without_outliers"
        ],
        "required_tools": [
          "table_retriever",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "datasets/operating_metrics/estimated_numbers.csv",
          "column": "No. of deaths_max",
          "method": "iqr",
          "threshold": 3
        }
      },
      "depends_on_rounds": [
        1,
        2
      ],
      "reuse_contract": {
        "produces": [
          "strategy:iqr_outlier",
          "outlier_artifact:disease_deaths_max"
        ],
        "consumes": [
          "schema_profile:disease_estimates",
          "stats_artifact:disease_cases_deaths"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "mean_no_of_deaths_with_outliers": "10149.43",
        "mean_no_of_deaths_without_outliers": "5949.08"
      },
      "quality_checks": [
        "numeric_tolerance:mean_no_of_deaths_with_outliers:0.01",
        "numeric_tolerance:mean_no_of_deaths_without_outliers:0.01"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 5,
      "task_id": "csv-profile-005",
      "dataset_id": "disease_estimates",
      "request_text": "Build a cleaned disease table artifact using the missingness and outlier decisions from earlier rounds.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "materialize_clean_table",
        "required_outputs": [
          "cleaned_table_ref",
          "cleaned_row_count",
          "cleaning_policy_hash"
        ],
        "required_tools": [
          "codeact_executor",
          "artifact_writer"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "datasets/operating_metrics/estimated_numbers.csv",
          "policy_sources": [
            "schema_profile:disease_estimates",
            "outlier_artifact:disease_deaths_max"
          ]
        }
      },
      "depends_on_rounds": [
        1,
        4
      ],
      "reuse_contract": {
        "produces": [
          "cleaned_table:disease_estimates"
        ],
        "consumes": [
          "schema_profile:disease_estimates",
          "outlier_artifact:disease_deaths_max"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "cleaned_table_created": "true"
      },
      "quality_checks": [
        "artifact_exists:cleaned_table_ref",
        "field_present:cleaning_policy_hash"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 2,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 6,
      "task_id": "csv-profile-006",
      "dataset_id": "weather_baro_2015",
      "request_text": "Profile baro_2015.csv and calculate the mean wind speed, reusing the CSV profiling and mean aggregation strategy from the disease dataset.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "profile_and_mean",
        "required_outputs": [
          "schema_profile_ref",
          "mean_windspeed"
        ],
        "required_tools": [
          "csv_profiler",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "weather_baro_2015",
          "csv_path": "datasets/operating_metrics/baro_2015.csv",
          "column": "WINDSPEED"
        }
      },
      "depends_on_rounds": [
        1,
        2
      ],
      "reuse_contract": {
        "produces": [
          "schema_profile:weather_baro_2015",
          "stats_artifact:weather_windspeed"
        ],
        "consumes": [
          "strategy:missingness_profile",
          "stats_artifact:disease_cases_deaths"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "mean_windspeed": "5.979"
      },
      "quality_checks": [
        "numeric_tolerance:mean_windspeed:0.001",
        "artifact_exists:schema_profile_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 7,
      "task_id": "csv-profile-007",
      "dataset_id": "weather_baro_2015",
      "request_text": "Calculate average WINDSPEED by month using the date parsing and groupby strategy from prior rounds.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "groupby_aggregate",
        "required_outputs": [
          "monthly_avg_windspeed",
          "groupby_artifact_ref"
        ],
        "required_tools": [
          "table_retriever",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "weather_baro_2015",
          "csv_path": "datasets/operating_metrics/baro_2015.csv",
          "groupby": "month(DATE TIME)",
          "value_column": "WINDSPEED",
          "aggregation": "mean"
        }
      },
      "depends_on_rounds": [
        6
      ],
      "reuse_contract": {
        "produces": [
          "strategy:monthly_groupby",
          "groupby_artifact:weather_monthly_windspeed"
        ],
        "consumes": [
          "schema_profile:weather_baro_2015"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "monthly_avg_windspeed.month_1": "7.17",
        "monthly_avg_windspeed.month_12": "5.52"
      },
      "quality_checks": [
        "numeric_tolerance:monthly_avg_windspeed.month_1:0.01",
        "numeric_tolerance:monthly_avg_windspeed.month_12:0.01"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 8,
      "task_id": "csv-profile-008",
      "dataset_id": "weather_baro_2015",
      "request_text": "Detect outliers in BARO using the IQR strategy learned from disease deaths outlier detection.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "detect_outliers",
        "required_outputs": [
          "baro_outlier_count",
          "outlier_artifact_ref"
        ],
        "required_tools": [
          "table_retriever",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "weather_baro_2015",
          "csv_path": "datasets/operating_metrics/baro_2015.csv",
          "column": "BARO",
          "method": "iqr",
          "threshold": 3
        }
      },
      "depends_on_rounds": [
        4,
        6
      ],
      "reuse_contract": {
        "produces": [
          "outlier_artifact:weather_baro"
        ],
        "consumes": [
          "strategy:iqr_outlier",
          "schema_profile:weather_baro_2015"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "baro_outlier_count": "111"
      },
      "quality_checks": [
        "exact:baro_outlier_count"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1,
        "L3_strategy_reuse_count_min": 1,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 9,
      "task_id": "csv-profile-009",
      "dataset_id": "weather_baro_2015",
      "request_text": "Materialize a cleaned weather table by removing WINDSPEED outliers and imputing AT with the mean temperature.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "materialize_clean_table",
        "required_outputs": [
          "cleaned_table_ref",
          "mean_wind_post",
          "mean_atmos_temp_post"
        ],
        "required_tools": [
          "codeact_executor",
          "artifact_writer"
        ],
        "arguments": {
          "dataset_id": "weather_baro_2015",
          "csv_path": "datasets/operating_metrics/baro_2015.csv",
          "outlier_column": "WINDSPEED",
          "impute_column": "AT",
          "outlier_method": "iqr",
          "outlier_threshold": 3
        }
      },
      "depends_on_rounds": [
        6,
        8
      ],
      "reuse_contract": {
        "produces": [
          "cleaned_table:weather_baro_2015"
        ],
        "consumes": [
          "schema_profile:weather_baro_2015",
          "strategy:iqr_outlier",
          "outlier_artifact:weather_baro"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "mean_wind_post": "5.76",
        "mean_atmos_temp_post": "52.47"
      },
      "quality_checks": [
        "numeric_tolerance:mean_wind_post:0.01",
        "numeric_tolerance:mean_atmos_temp_post:0.01",
        "artifact_exists:cleaned_table_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 2,
        "L3_skipped_step_count_min": 0
      }
    },
    {
      "round": 10,
      "task_id": "csv-profile-010",
      "dataset_id": "weather_baro_2015",
      "request_text": "Produce a final cross-dataset reuse report that cites the disease and weather artifacts reused, the strategies transferred, and the final weather cleaning results.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "summarize_reuse_lineage",
        "required_outputs": [
          "summary_text",
          "reuse_report_ref",
          "reused_artifact_count",
          "reused_strategy_count"
        ],
        "required_tools": [
          "artifact_reader",
          "summarizer"
        ],
        "arguments": {
          "source_rounds": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9
          ],
          "required_lineage": [
            "schema_profile:disease_estimates",
            "cleaned_table:disease_estimates",
            "schema_profile:weather_baro_2015",
            "cleaned_table:weather_baro_2015"
          ]
        }
      },
      "depends_on_rounds": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ],
      "reuse_contract": {
        "produces": [
          "reuse_report:csv_table_profile_v1"
        ],
        "consumes": [
          "schema_profile:disease_estimates",
          "stats_artifact:disease_cases_deaths",
          "strategy:pearson_correlation",
          "outlier_artifact:disease_deaths_max",
          "strategy:iqr_outlier",
          "cleaned_table:disease_estimates",
          "schema_profile:weather_baro_2015",
          "strategy:monthly_groupby",
          "groupby_artifact:weather_monthly_windspeed",
          "outlier_artifact:weather_baro",
          "cleaned_table:weather_baro_2015"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "reused_artifact_count_min": "7",
        "reused_strategy_count_min": "3"
      },
      "quality_checks": [
        "field_gte:reused_artifact_count:7",
        "field_gte:reused_strategy_count:3",
        "artifact_exists:reuse_report_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 7,
        "L3_skipped_step_count_min": 0,
        "L3_reuse_gain_min": 0,
        "L3_history_reuse_gain_min": 1,
        "L3_history_step_reduction_count_min": 2
      }
    }
  ]
}
