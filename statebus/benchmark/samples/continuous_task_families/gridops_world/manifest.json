{
  "schema_version": "statebus.continuous_task_family.v1",
  "family_id": "gridops_world_v1",
  "display_name": "GridOps typed world-state and route memory demo",
  "claim_tier": "demo_secondary",
  "round_count": 10,
  "datasets": [
    {
      "dataset_id": "gridops_alpha",
      "path": "statebus/benchmark/samples/continuous_task_families/gridops_world/world_alpha.json",
      "kind": "grid_world"
    }
  ],
  "quality_floor": {
    "deterministic_validator": [
      "success_state_reached",
      "invalid_action_count_within_budget",
      "path_length_within_budget"
    ],
    "fact_coverage": [
      "required_state_refs_present",
      "required_route_memory_refs_present"
    ],
    "llm_judge": "not_required"
  },
  "l0_l3_expectations": {
    "L0": {
      "expected_zero_metrics": [
        "semantic_state_transfer_count",
        "skipped_step_count"
      ]
    },
    "L1": {
      "required": [
        "control_bytes_delta_l0_to_l1 < 0"
      ]
    },
    "L2": {
      "required": [
        "semantic_state_transfer_count > 0",
        "prompt_visible_total_bytes_delta_l1_to_l2 < 0"
      ]
    },
    "L3": {
      "required": [
        "memory_match_count > 0",
        "route_reuse_count > 0",
        "skipped_step_count > 0"
      ],
      "target_nonzero_rounds": [
        3,
        4,
        5,
        6,
        8,
        10
      ]
    }
  },
  "rounds": [
    {
      "round": 1,
      "task_id": "gridops-001",
      "dataset_id": "gridops_alpha",
      "request_text": "Explore the grid from S and persist a topology state with reachable cells, walls, and object coordinates.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "map_topology",
        "required_outputs": [
          "world_state_ref",
          "topology_ref"
        ],
        "required_tools": [
          "gridops_simulator",
          "state_ref_writer"
        ],
        "arguments": {
          "world_id": "gridops-alpha"
        }
      },
      "depends_on_rounds": [],
      "reuse_contract": {
        "produces": [
          "world_state:gridops_alpha",
          "topology:gridops_alpha"
        ],
        "consumes": [],
        "minimum_reuse_class": "none"
      },
      "expected_facts": {
        "reachable_cell_count_min": "30",
        "object_count_min": "6"
      },
      "quality_checks": [
        "artifact_exists:world_state_ref",
        "field_gte:reachable_cell_count:30"
      ],
      "expected_metric_effects": {
        "L2_semantic_state_transfer_count_min": 1
      }
    },
    {
      "round": 2,
      "task_id": "gridops-002",
      "dataset_id": "gridops_alpha",
      "request_text": "Find the key and locked door, then persist the unlock rule and shortest path from S to K.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "discover_unlock_rule",
        "required_outputs": [
          "route_ref",
          "rule_memory_ref"
        ],
        "required_tools": [
          "gridops_planner",
          "state_ref_reader"
        ],
        "arguments": {
          "start": "S",
          "target": "K",
          "rule": "key_before_door"
        }
      },
      "depends_on_rounds": [
        1
      ],
      "reuse_contract": {
        "produces": [
          "route:S_to_K",
          "rule:key_before_door"
        ],
        "consumes": [
          "topology:gridops_alpha"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "rule": "key_before_door"
      },
      "quality_checks": [
        "artifact_exists:route_ref",
        "artifact_exists:rule_memory_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1
      }
    },
    {
      "round": 3,
      "task_id": "gridops-003",
      "dataset_id": "gridops_alpha",
      "request_text": "Move the crate C to drop zone A using the topology and key-door rule.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "deliver_crate",
        "required_outputs": [
          "action_plan_ref",
          "success_state"
        ],
        "required_tools": [
          "gridops_planner",
          "gridops_simulator"
        ],
        "arguments": {
          "crate": "C",
          "drop_zone": "A"
        }
      },
      "depends_on_rounds": [
        1,
        2
      ],
      "reuse_contract": {
        "produces": [
          "route:C_to_A",
          "action_plan:deliver_C_to_A"
        ],
        "consumes": [
          "topology:gridops_alpha",
          "rule:key_before_door",
          "route:S_to_K"
        ],
        "minimum_reuse_class": "validated_replay"
      },
      "expected_facts": {
        "success_state": "crate_at_A"
      },
      "quality_checks": [
        "exact:success_state",
        "field_lte:invalid_action_count:0"
      ],
      "expected_metric_effects": {
        "L3_route_reuse_count_min": 1,
        "L3_skipped_step_count_min": 1
      }
    },
    {
      "round": 4,
      "task_id": "gridops-004",
      "dataset_id": "gridops_alpha",
      "request_text": "Replan delivery to zone A after a new blocked cell appears at row 5 column 4, and persist the route delta.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "replan_with_obstacle",
        "required_outputs": [
          "route_delta_ref",
          "updated_topology_ref"
        ],
        "required_tools": [
          "gridops_planner",
          "state_ref_writer"
        ],
        "arguments": {
          "blocked_cell": [
            5,
            4
          ],
          "target_route": "route:C_to_A"
        }
      },
      "depends_on_rounds": [
        1,
        3
      ],
      "reuse_contract": {
        "produces": [
          "topology:gridops_alpha_obstacle_v1",
          "route_delta:C_to_A_obstacle_v1"
        ],
        "consumes": [
          "topology:gridops_alpha",
          "route:C_to_A"
        ],
        "minimum_reuse_class": "validated_replay"
      },
      "expected_facts": {
        "route_delta_created": "true"
      },
      "quality_checks": [
        "artifact_exists:route_delta_ref",
        "artifact_exists:updated_topology_ref"
      ],
      "expected_metric_effects": {
        "L3_route_reuse_count_min": 1,
        "L3_skipped_step_count_min": 1
      }
    },
    {
      "round": 5,
      "task_id": "gridops-005",
      "dataset_id": "gridops_alpha",
      "request_text": "Plan a two-crate schedule to zones A and B using stored topology and route segments.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "schedule_multi_crate",
        "required_outputs": [
          "schedule_ref",
          "route_reuse_count"
        ],
        "required_tools": [
          "gridops_planner"
        ],
        "arguments": {
          "drop_zones": [
            "A",
            "B"
          ],
          "reuse_routes": [
            "route:C_to_A",
            "route_delta:C_to_A_obstacle_v1"
          ]
        }
      },
      "depends_on_rounds": [
        3,
        4
      ],
      "reuse_contract": {
        "produces": [
          "schedule:two_crate_A_B"
        ],
        "consumes": [
          "route:C_to_A",
          "route_delta:C_to_A_obstacle_v1"
        ],
        "minimum_reuse_class": "validated_replay"
      },
      "expected_facts": {
        "route_reuse_count_min": "2"
      },
      "quality_checks": [
        "field_gte:route_reuse_count:2",
        "artifact_exists:schedule_ref"
      ],
      "expected_metric_effects": {
        "L3_route_reuse_count_min": 2,
        "L3_skipped_step_count_min": 1
      }
    },
    {
      "round": 6,
      "task_id": "gridops-006",
      "dataset_id": "gridops_alpha",
      "request_text": "Find a route to zone A under an energy budget of 18 actions using stored route memory.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "plan_with_energy_budget",
        "required_outputs": [
          "budgeted_route_ref",
          "path_length"
        ],
        "required_tools": [
          "gridops_planner"
        ],
        "arguments": {
          "target": "A",
          "energy_budget": 18
        }
      },
      "depends_on_rounds": [
        3,
        4
      ],
      "reuse_contract": {
        "produces": [
          "route:budgeted_to_A"
        ],
        "consumes": [
          "route:C_to_A",
          "route_delta:C_to_A_obstacle_v1"
        ],
        "minimum_reuse_class": "validated_replay"
      },
      "expected_facts": {
        "path_length_lte": "18"
      },
      "quality_checks": [
        "field_lte:path_length:18",
        "artifact_exists:budgeted_route_ref"
      ],
      "expected_metric_effects": {
        "L3_route_reuse_count_min": 1,
        "L3_skipped_step_count_min": 1
      }
    },
    {
      "round": 7,
      "task_id": "gridops-007",
      "dataset_id": "gridops_alpha",
      "request_text": "Identify the hazard zone H and persist a hazard-avoidance memory rule.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "discover_hazard_rule",
        "required_outputs": [
          "hazard_rule_ref",
          "hazard_cell"
        ],
        "required_tools": [
          "gridops_simulator",
          "state_ref_reader"
        ],
        "arguments": {
          "hazard_symbol": "H"
        }
      },
      "depends_on_rounds": [
        1
      ],
      "reuse_contract": {
        "produces": [
          "rule:avoid_hazard_H"
        ],
        "consumes": [
          "world_state:gridops_alpha"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "hazard_cell": "H"
      },
      "quality_checks": [
        "artifact_exists:hazard_rule_ref",
        "exact:hazard_cell"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 1
      }
    },
    {
      "round": 8,
      "task_id": "gridops-008",
      "dataset_id": "gridops_alpha",
      "request_text": "Plan a route to zone B that avoids H and reuses previously stored route segments.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "route_to_goal_with_rule",
        "required_outputs": [
          "safe_route_ref",
          "route_reuse_count"
        ],
        "required_tools": [
          "gridops_planner",
          "gridops_simulator"
        ],
        "arguments": {
          "target": "B",
          "avoid_rule": "rule:avoid_hazard_H"
        }
      },
      "depends_on_rounds": [
        5,
        7
      ],
      "reuse_contract": {
        "produces": [
          "route:safe_to_B"
        ],
        "consumes": [
          "schedule:two_crate_A_B",
          "rule:avoid_hazard_H"
        ],
        "minimum_reuse_class": "validated_replay"
      },
      "expected_facts": {
        "route_reuse_count_min": "1"
      },
      "quality_checks": [
        "field_gte:route_reuse_count:1",
        "artifact_exists:safe_route_ref"
      ],
      "expected_metric_effects": {
        "L3_route_reuse_count_min": 1,
        "L3_skipped_step_count_min": 1
      }
    },
    {
      "round": 9,
      "task_id": "gridops-009",
      "dataset_id": "gridops_alpha",
      "request_text": "Apply the learned key-door and hazard-avoidance strategy to a mirrored goal layout and persist a reusable strategy template.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "transfer_strategy_template",
        "required_outputs": [
          "strategy_template_ref",
          "transferred_rule_count"
        ],
        "required_tools": [
          "gridops_planner",
          "memory_reader"
        ],
        "arguments": {
          "rules": [
            "rule:key_before_door",
            "rule:avoid_hazard_H"
          ]
        }
      },
      "depends_on_rounds": [
        2,
        7
      ],
      "reuse_contract": {
        "produces": [
          "strategy_template:key_door_hazard"
        ],
        "consumes": [
          "rule:key_before_door",
          "rule:avoid_hazard_H"
        ],
        "minimum_reuse_class": "assist"
      },
      "expected_facts": {
        "transferred_rule_count_min": "2"
      },
      "quality_checks": [
        "field_gte:transferred_rule_count:2",
        "artifact_exists:strategy_template_ref"
      ],
      "expected_metric_effects": {
        "L3_artifact_reuse_count_min": 2
      }
    },
    {
      "round": 10,
      "task_id": "gridops-010",
      "dataset_id": "gridops_alpha",
      "request_text": "Solve the combined key, door, crate, hazard, and energy-budget task using all prior world-state, route, and strategy memories.",
      "canonical_task_spec": {
        "task_family": "continuous_gridops_world",
        "intent_op": "solve_combined_goal",
        "required_outputs": [
          "final_action_plan_ref",
          "success_state",
          "reused_memory_count"
        ],
        "required_tools": [
          "gridops_planner",
          "gridops_simulator",
          "memory_reader"
        ],
        "arguments": {
          "goal": "deliver_crate_to_A_then_reach_B",
          "energy_budget": 36,
          "required_memories": [
            "topology:gridops_alpha",
            "rule:key_before_door",
            "rule:avoid_hazard_H",
            "strategy_template:key_door_hazard"
          ]
        }
      },
      "depends_on_rounds": [
        1,
        2,
        3,
        7,
        8,
        9
      ],
      "reuse_contract": {
        "produces": [
          "final_plan:gridops_alpha"
        ],
        "consumes": [
          "topology:gridops_alpha",
          "route:C_to_A",
          "route:safe_to_B",
          "rule:key_before_door",
          "rule:avoid_hazard_H",
          "strategy_template:key_door_hazard"
        ],
        "minimum_reuse_class": "exact_replay"
      },
      "expected_facts": {
        "success_state": "combined_goal_complete",
        "reused_memory_count_min": "6"
      },
      "quality_checks": [
        "exact:success_state",
        "field_gte:reused_memory_count:6",
        "artifact_exists:final_action_plan_ref"
      ],
      "expected_metric_effects": {
        "L3_route_reuse_count_min": 2,
        "L3_skipped_step_count_min": 2,
        "L3_reuse_gain_min": 1
      }
    }
  ]
}
