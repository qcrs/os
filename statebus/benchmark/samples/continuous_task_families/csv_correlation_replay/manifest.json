{
  "schema_version": "statebus.continuous_task_family.v1",
  "family_id": "csv_correlation_replay_v1",
  "display_name": "CSV correlation replay admissibility chain",
  "claim_tier": "formal_primary",
  "source_basis": {
    "repo_task_files": [
      "datasets/operating_metrics/estimated_numbers.csv"
    ],
    "design_note": "Replay-admissible CSV continuous family built on disease estimates so replay evidence is proven on a second formal task family instead of only the long-document chain."
  },
  "round_count": 10,
  "datasets": [
    {
      "dataset_id": "disease_estimates",
      "path": "datasets/operating_metrics/estimated_numbers.csv",
      "kind": "csv",
      "primary_columns": [
        "Country",
        "Year",
        "No. of cases",
        "No. of deaths",
        "No. of cases_median",
        "No. of cases_min",
        "No. of cases_max",
        "No. of deaths_median",
        "No. of deaths_min",
        "No. of deaths_max",
        "WHO Region"
      ]
    }
  ],
  "quality_floor": {
    "deterministic_validator": [
      "answer_fields_present",
      "numeric_tolerance",
      "artifact_manifest_present"
    ],
    "fact_coverage": [
      "expected_fields_match_gold",
      "required_artifact_refs_present"
    ],
    "llm_judge": "optional_explanation_only"
  },
  "l0_l3_expectations": {
    "L0": {
      "required": [
        "quality_floor_pass"
      ],
      "expected_zero_metrics": [
        "semantic_state_transfer_count",
        "skipped_step_count"
      ]
    },
    "L1": {
      "required": [
        "control_bytes_delta_l0_to_l1 < 0"
      ]
    },
    "L2": {
      "required": [
        "semantic_state_transfer_count > 0",
        "raw_evidence_bytes_seen_by_llm_delta_l1_to_l2 < 0"
      ]
    },
    "L3": {
      "required": [
        "memory_match_count > 0",
        "validated_replay_count > 0",
        "skipped_step_count > 0"
      ],
      "target_nonzero_rounds": [
        3,
        4,
        5,
        6,
        7,
        8,
        9,
        10
      ]
    }
  },
  "rounds": [
    {
      "round": 1,
      "task_id": "replay-csv-001",
      "dataset_id": "disease_estimates",
      "request_text": "Replay-track bootstrap: profile estimated_numbers.csv, persist the reusable schema profile, and capture missingness percentages for No. of cases_min and No. of deaths_max.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "profile_table",
        "required_outputs": [
          "schema_profile_ref",
          "missingness_summary",
          "summary_text"
        ],
        "required_tools": [
          "csv_profiler",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "datasets/operating_metrics/estimated_numbers.csv",
          "columns": [
            "No. of cases_min",
            "No. of deaths_max"
          ]
        }
      },
      "depends_on_rounds": [],
      "reuse_contract": {
        "produces": [
          "schema_profile:disease_estimates",
          "strategy:missingness_profile"
        ],
        "consumes": [],
        "minimum_reuse_class": "none"
      },
      "expected_facts": {
        "percentage_cases_min": "36.45",
        "percentage_deaths_max": "38.79"
      },
      "quality_checks": [
        "numeric_tolerance:percentage_cases_min:0.01",
        "numeric_tolerance:percentage_deaths_max:0.01",
        "artifact_exists:schema_profile_ref"
      ],
      "expected_metric_effects": {
        "L2_semantic_state_transfer_count_min": 1
      }
    },
    {
      "round": 2,
      "task_id": "replay-csv-002",
