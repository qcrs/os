      "expected_facts": {
        "correlation_coefficient": "0.97"
      },
      "quality_checks": [
        "artifact_exists:correlation_artifact_ref",
        "numeric_tolerance:correlation_coefficient:0.01"
      ],
      "expected_metric_effects": {}
