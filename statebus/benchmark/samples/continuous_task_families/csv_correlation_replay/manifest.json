      "request_text": "Replay-track disease correlation: calculate the Pearson correlation between No. of cases and No. of deaths after applying the persisted missingness policy.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "correlate_columns",
        "required_outputs": [
          "correlation_artifact_ref",
          "correlation_coefficient"
        ],
        "required_tools": [
          "table_retriever",
          "codeact_executor"
        ],
        "arguments": {
          "dataset_id": "disease_estimates",
          "csv_path": "datasets/operating_metrics/estimated_numbers.csv",
          "left_column": "No. of cases",
          "right_column": "No. of deaths",
          "method": "pearson"
        }
      },
      "depends_on_rounds": [
        1
      ],
      "reuse_contract": {
        "produces": [
          "strategy:pearson_correlation",
          "correlation_artifact:cases_vs_deaths"
