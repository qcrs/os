{
  "schema_version": "statebus.continuous_task_family.v1",
  "family_id": "kv_prefix_reuse_v1",
  "display_name": "KV prefix reuse probe with two realistic operating reports",
  "claim_tier": "demo_secondary",
  "source_basis": {
    "design_note": "Mechanism-only dataset for StateBus cache-aware prompt layout and corpus-aware scheduling. It uses two independent markdown operating reports with the same metric schema so cache-friendly and cache-hostile orderings can be compared without changing task semantics.",
    "claim_boundary": "engine_local_prefix_reuse_probe_only_no_kv_tensor_export",
    "not_default_formal_chain": true,
    "why_realistic": "The reports describe two different operating domains, include management narrative, margin/cost/customer/delivery notes, and carry deterministic metric tables for validation.",
    "schedule_modes": [
      "cache_friendly",
      "cache_hostile"
    ]
  },
  "round_count": 10,
  "datasets": [
    {
      "dataset_id": "orion_factory_ops_2026",
      "path": "statebus/benchmark/samples/continuous_task_families/kv_prefix_reuse/orion_factory_ops_report_2026.md",
      "kind": "markdown_long_doc",
      "primary_entities": [
        "Orion Factory Systems",
        "manufacturing",
        "revenue_musd",
        "gross_margin_pct",
        "operating_expense_musd",
        "churn_rate_pct",
        "on_time_delivery_pct"
      ]
    },
    {
      "dataset_id": "nova_retail_ops_2026",
      "path": "statebus/benchmark/samples/continuous_task_families/kv_prefix_reuse/nova_retail_ops_report_2026.md",
      "kind": "markdown_long_doc",
      "primary_entities": [
        "Nova Retail Logistics",
        "fulfillment",
        "revenue_musd",
        "gross_margin_pct",
        "operating_expense_musd",
        "churn_rate_pct",
        "on_time_delivery_pct"
      ]
    }
  ],
  "quality_floor": {
    "deterministic_validator": [
      "answer_fields_present",
      "artifact_manifest_present",
      "numeric_tolerance"
    ],
    "fact_coverage": [
      "required_metric_values_match",
      "metric_name_matches_request"
    ],
    "llm_judge": "not_required"
  },
  "l0_l3_expectations": {
    "L0": {
      "expected_zero_metrics": [
        "semantic_state_transfer_count",
        "skipped_step_count"
      ]
    },
    "L1": {
      "required": [
        "control_bytes_delta_l0_to_l1 < 0"
      ]
    },
    "L2": {
      "required": [
        "semantic_state_transfer_count > 0",
        "evidence_pruning_estimated_kv_tokens_saved > 0"
      ]
    },
    "L3": {
      "required": [
        "kv_corpus_prefix_hash_reuse_count > 0",
        "kv_corpus_level_prefill_saved_tokens_estimate > 0"
      ],
      "target_nonzero_rounds": [
        3,
        4,
        5,
        6,
        8,
        9,
        10
      ]
    }
  },
  "kv_prefix_probe": {
    "schema_version": "statebus.kv_prefix_probe_family.v1",
    "shared_prefix_policy": "system_plus_static_corpus_evidence",
    "role_suffix_policy": "compact_role_instruction_and_json_schema_only",
    "schedule_key": "corpus_prefix_hash",
    "cache_friendly_order": [
      "kv-orion-001",
      "kv-orion-002",
      "kv-orion-003",
      "kv-orion-004",
      "kv-orion-005",
      "kv-nova-001",
      "kv-nova-002",
      "kv-nova-003",
      "kv-nova-004",
      "kv-nova-005"
    ],
    "cache_hostile_order": [
      "kv-orion-001",
      "kv-nova-001",
      "kv-orion-002",
      "kv-nova-002",
      "kv-orion-003",
      "kv-nova-003",
      "kv-orion-004",
      "kv-nova-004",
      "kv-orion-005",
      "kv-nova-005"
    ],
    "expected_observations": [
      "cache_friendly should produce a larger contiguous same-corpus window than cache_hostile",
      "local vLLM APC evidence requires prefix-cache metrics and streaming TTFT, not just estimated tokens",
      "quality_floor_pass_rate must remain unchanged across schedules"
    ]
  },
