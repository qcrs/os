{
  "schema_version": "statebus.semantic_holdout_manifest.v1",
  "suite_id": "semantic_holdout_v1",
  "cases": [
    {
      "task_id": "semantic-holdout-s1",
      "input_shape": "narrative_only",
      "request_text": "From the complete Meridian network review, identify the named operating region and the binding fulfillment constraint. Return each fact with the section heading that locates it.",
      "canonical_task_spec": {
        "task_family": "continuous_long_doc_table_analysis",
        "intent_op": "extract_narrative_facts",
        "target_entities": ["Meridian network"],
        "time_scope": "spring planning cycle",
        "required_outputs": ["operating_region", "region_locator", "binding_constraint", "constraint_locator"],
        "required_tools": [],
        "arguments": {
          "dataset_id": "meridian-network-review",
          "document_path": "statebus/benchmark/samples/semantic_holdout/meridian_network_review.md",
          "source_path": "statebus/benchmark/samples/semantic_holdout/meridian_network_review.md",
          "source_kind": "narrative_markdown",
          "output_schema": {
            "operating_region": "string",
            "region_locator": "string",
            "binding_constraint": "string",
            "constraint_locator": "string"
          },
          "fact_selectors": [
            {
              "output_field": "operating_region",
              "locator_field": "region_locator",
              "section": "Market signal",
              "label": "The operating region"
            },
            {
              "output_field": "binding_constraint",
              "locator_field": "constraint_locator",
              "section": "Fulfillment constraint",
              "label": "The binding constraint"
            }
          ]
        }
      }
    },
    {
      "task_id": "semantic-holdout-s2",
      "input_shape": "narrative_only",
      "request_text": "Use the complete Meridian review to summarize the recorded demand cause and operating effect together with the conditional delivery risk and its stated mitigation.",
      "canonical_task_spec": {
        "task_family": "continuous_long_doc_table_analysis",
        "intent_op": "synthesize_narrative_risk",
        "target_entities": ["Meridian network"],
        "time_scope": "spring planning cycle",
        "required_outputs": ["demand_cause", "operational_effect", "conditional_risk", "stated_mitigation"],
        "required_tools": [],
        "arguments": {
          "dataset_id": "meridian-network-review",
          "document_path": "statebus/benchmark/samples/semantic_holdout/meridian_network_review.md",
          "source_path": "statebus/benchmark/samples/semantic_holdout/meridian_network_review.md",
          "source_kind": "narrative_markdown",
          "output_schema": {
            "demand_cause": "string",
            "operational_effect": "string",
            "conditional_risk": "string",
            "stated_mitigation": "string"
          },
          "fact_selectors": [
            {
              "output_field": "demand_cause",
              "section": "Causal chain",
              "label": "The primary demand cause"
            },
            {
              "output_field": "operational_effect",
              "section": "Causal chain",
              "label": "The operational effect"
            },
            {
              "output_field": "conditional_risk",
              "section": "Risk response",
              "label": "The conditional risk"
            },
            {
              "output_field": "stated_mitigation",
              "section": "Risk response",
              "label": "The stated mitigation"
            }
          ]
        }
      }
    },
    {
      "task_id": "semantic-holdout-s3",
      "input_shape": "table_only",
      "request_text": "In the authorized service-level table, look up Harbor East for 2026Q2 and return the facility, period, backlog units, and SLA hours from that unique row.",
      "canonical_task_spec": {
        "task_family": "continuous_csv_table_analysis",
        "intent_op": "lookup_table_record",
        "target_entities": ["Harbor East"],
        "time_scope": "2026Q2",
        "required_outputs": ["facility", "period", "backlog_units", "sla_hours"],
        "required_tools": [],
        "arguments": {
          "dataset_id": "harbor-service-levels",
          "csv_path": "statebus/benchmark/samples/semantic_holdout/harbor_service_levels.csv",
          "source_path": "statebus/benchmark/samples/semantic_holdout/harbor_service_levels.csv",
          "source_kind": "csv_table",
          "metric": "backlog_units",
          "filters": {
            "facility": "Harbor East",
            "period": "2026Q2"
          },
          "value_fields": ["facility", "period", "backlog_units", "sla_hours"],
          "output_schema": {
            "facility": "string",
            "period": "string",
            "backlog_units": "integer",
            "sla_hours": "integer"
          }
        }
      }
    },
    {
      "task_id": "semantic-holdout-s4",
      "input_shape": "mixed_narrative_table",
      "request_text": "For Delta Hub in 2026Q2, combine the observed throughput row with the shipment qualification stated in the same review. Return both source values and the qualifier's section heading.",
      "canonical_task_spec": {
        "task_family": "continuous_long_doc_table_analysis",
        "intent_op": "lookup_table_with_qualifier",
        "target_entities": ["Delta Hub"],
        "time_scope": "2026Q2",
        "required_outputs": ["region", "period", "throughput_units", "shipment_qualifier", "qualifier_locator"],
        "required_tools": [],
        "arguments": {
          "dataset_id": "delta-hub-review",
          "document_path": "statebus/benchmark/samples/semantic_holdout/delta_hub_review.md",
          "source_path": "statebus/benchmark/samples/semantic_holdout/delta_hub_review.md",
          "source_kind": "mixed_markdown",
          "metric": "throughput_units",
          "table_row_limit": 4,
          "filters": {
            "region": "Delta Hub",
            "period": "2026Q2"
          },
          "value_fields": ["region", "period", "throughput_units"],
          "output_schema": {
            "region": "string",
            "period": "string",
            "throughput_units": "integer",
            "shipment_qualifier": "string",
            "qualifier_locator": "string"
          },
          "fact_selectors": [
            {
              "output_field": "shipment_qualifier",
              "locator_field": "qualifier_locator",
              "section": "Operating constraint",
              "label": "The shipment qualifier"
            }
          ]
        }
      }
    }
  ]
}
